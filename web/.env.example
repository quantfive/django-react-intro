# PostHog Configuration
# Get these values from your PostHog account at https://posthog.com

# Your PostHog Project API Key (starts with phc_)
REACT_APP_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY

# Your PostHog Project ID (numeric value from your project URL)
REACT_APP_POSTHOG_PROJECT_ID=YOUR_PROJECT_ID

# PostHog Host (use https://app.posthog.com for cloud, or your self-hosted URL)
REACT_APP_POSTHOG_HOST=https://app.posthog.com
