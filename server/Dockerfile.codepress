# Generated by CodePress bootstrap-app-server.
# Edits are preserved, but running /codepress-bootstrap-app-server again may overwrite them.

FROM python:3.7-slim
WORKDIR /app

# django-allauth 0.33.0 uses setuptools.convert_path (removed in setuptools 60)
RUN pip install --no-cache-dir "setuptools<60"
# Django 1.11.5 has Python 3.7 incompatibilities; 1.11.29 is the last patch with fixes
RUN pip install --no-cache-dir \
    "django==1.11.29" \
    "djangorestframework==3.6.4" \
    "django-rest-auth==0.9.1" \
    "django-allauth==0.33.0"

COPY . .

# Create the directory tree STATICFILES_DIRS expects so Django starts cleanly
RUN mkdir -p static/build/static

ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=server.settings

# Run database migrations (SQLite — no external service)
RUN python manage.py migrate

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
