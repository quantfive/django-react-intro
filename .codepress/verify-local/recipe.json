{
  "schema_version": 1,
  "setup_commands": [
    ["yarn", "--cwd", "web", "install", "--frozen-lockfile"],
    ["pipenv", "sync"],
    ["mkdir", "-p", "server/static"]
  ],
  "services": [
    {
      "id": "backend",
      "executor": "native",
      "command": ["pipenv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"],
      "working_dir": "server",
      "required": true,
      "port": 8000,
      "browser": false,
      "env_defaults": {},
      "required_bindings": [],
      "fixtures": [
        ["pipenv", "run", "python", "manage.py", "migrate", "--noinput"]
      ],
      "health": {
        "path": "/admin/login/",
        "status_codes": [200],
        "timeout_seconds": 60
      }
    },
    {
      "id": "web",
      "executor": "native",
      "command": ["yarn", "start"],
      "working_dir": "web",
      "required": true,
      "port": 3000,
      "browser": true,
      "env_defaults": {
        "BROWSER": "none"
      },
      "required_bindings": [],
      "fixtures": [],
      "health": {
        "path": "/",
        "status_codes": [200],
        "timeout_seconds": 90
      }
    }
  ],
  "checks": [
    {
      "id": "backend-tests",
      "executor": "native",
      "command": ["pipenv", "run", "python", "manage.py", "test"],
      "working_dir": "server",
      "timeout_seconds": 900,
      "expected_exit_codes": [0],
      "env_defaults": {},
      "required_bindings": []
    },
    {
      "id": "frontend-tests",
      "executor": "native",
      "command": ["yarn", "test", "--watchAll=false"],
      "working_dir": "web",
      "timeout_seconds": 900,
      "expected_exit_codes": [0],
      "env_defaults": {
        "CI": "true"
      },
      "required_bindings": []
    },
    {
      "id": "frontend-build",
      "executor": "native",
      "command": ["yarn", "build"],
      "working_dir": "web",
      "timeout_seconds": 900,
      "expected_exit_codes": [0],
      "env_defaults": {},
      "required_bindings": []
    }
  ]
}
