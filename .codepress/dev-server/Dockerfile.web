# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 16 (Debian bullseye, full image — ships the node-gyp toolchain and apt).
# This app pins react-scripts@1.0.10 (webpack 3), whose build hashing uses MD4.
# Node 17+ ships OpenSSL 3, which gates MD4 and crashes `react-scripts start`
# with `digital envelope routines::unsupported`. Node 16 (OpenSSL 1.1.1) runs
# this legacy CRA toolchain unmodified. Pulled from the AWS public-ECR mirror to
# avoid Docker Hub anonymous pull rate limits during concurrent frontend builds.
FROM public.ecr.aws/docker/library/node:16-bullseye

# System packages the dev runtime needs. `procps` only: this CRA app has no
# source-built native module that links a system library, so no extra apt
# package is required (add one here only for a source-built native module).
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack so the repo's package manager (yarn) resolves. No
# `packageManager` field is declared, so no exact version is pre-activated —
# this bakes only the package-manager shim, never app dependencies.
RUN corepack enable

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install` in this image
# against the bind-mounted checkout). Only the toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
#   HOST                          CRA's bind var (alias of the container bind host).
#   DANGEROUSLY_DISABLE_HOST_CHECK webpack-dev-server otherwise rejects the preview
#                                  proxy's Host header ("Invalid Host header"); this
#                                  is the CRA analogue of Vite's allowedHosts.
#   CI=false                       keep `react-scripts start` from treating lint
#                                  warnings as fatal under an ambient CI=true.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss \
    DANGEROUSLY_DISABLE_HOST_CHECK=true \
    CI=false

WORKDIR /app/web
EXPOSE 3000

# Put the app + root node_modules bins on PATH as a backstop so a directly
# invoked bin resolves even before pm-exec. Populated at run time on the
# bind-mounted checkout. Prepend, never replace ${PATH}, so corepack/yarn shims
# survive.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on). CRA reads HOST/PORT from env; map the CodePress bind host
# and the public HMR websocket port/protocol so webpack-dev-server's client
# connects through the preview proxy instead of assuming localhost. Route through
# the package manager (`yarn start`), never a bare `react-scripts`.
CMD ["sh", "-c", "HOST=\"$CODEPRESS_BIND_HOST\" WDS_SOCKET_PORT=\"$CODEPRESS_HMR_CLIENT_PORT\" WDS_SOCKET_PROTOCOL=\"$CODEPRESS_HMR_PROTOCOL\" yarn start"]
