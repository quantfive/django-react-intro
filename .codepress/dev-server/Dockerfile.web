# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 18 (not the newest LTS) is deliberate: this app pins the 2017-era
# create-react-app toolchain (react-scripts 1.0.10 / webpack 2.6.1 /
# webpack-dev-server 2.5.0 / babel-core 6), which is not exercised against
# current Node majors. Node 18 is the oldest Debian *bookworm* Node image and
# gives that toolchain the widest compatibility. Bump this once the frontend
# dependencies are modernised.
FROM public.ecr.aws/docker/library/node:18-bookworm

# System packages the dev runtime needs. `procps` only: this app has no
# source-built native modules (its single native dep, `fsevents`, is macOS-only
# and skipped on Linux), so no extra apt library is required.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# Bake the package-manager binary (not app dependencies) so a cold start never
# has to fetch yarn from the public registry before the dev server can run.
# The repo declares no `packageManager` field and ships a yarn v1 lockfile.
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install` in this image
# against the bind-mounted checkout). Only the toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
# `HOST` is create-react-app's own bind knob (the alias of `HOSTNAME` for CRA).
ENV HOSTNAME=0.0.0.0 \
    HOST=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss \
    CODEPRESS_BASE_PATH=/ \
    BROWSER=none

# react-scripts 1.0.10 disables webpack-dev-server's Host-header check whenever
# the app declares no `proxy` (which is the case today), so preview hostnames are
# already accepted. Set the explicit opt-out too, so adding a `proxy` field later
# cannot silently break previews with "Invalid Host header".
ENV DANGEROUSLY_DISABLE_HOST_CHECK=true

# This era of webpack hashes with md5, which OpenSSL 3 still provides — but any
# transitive md4 use would otherwise crash with
# "error:0308010C:digital envelope routines::unsupported". Cheap insurance.
ENV NODE_OPTIONS=--openssl-legacy-provider

WORKDIR /app/web
EXPOSE 3000

# Put the workspace bins on PATH so the dev command — and anything it shells out
# to — resolves node_modules/.bin even when a binary is invoked directly. These
# dirs are populated at run time on the bind-mounted checkout.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on). `react-scripts start` reads HOST and PORT from env.
# WDS_SOCKET_PORT is passed for the uniform runtime contract; this pinned
# react-dev-utils (3.0.2) predates that flag and instead derives the HMR socket
# URL from the page origin (window.location), which is exactly what a proxied
# `wss://<session>.preview.codepress.dev` preview needs — no client-port wiring
# required. Invoked through yarn, never a bare `react-scripts` binary.
CMD ["sh", "-c", "HOST=${CODEPRESS_BIND_HOST:-0.0.0.0} PORT=${PORT:-3000} WDS_SOCKET_PORT=${CODEPRESS_HMR_CLIENT_PORT:-443} BROWSER=none yarn start"]
