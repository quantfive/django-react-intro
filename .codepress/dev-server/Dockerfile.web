# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 18 (not the newest LTS) is deliberate: this frontend is Create React App
# 1.0.10 / React 15 era tooling (webpack 3, babel 6, eslint 4), which is much
# happier on an older Node line. Bump this only alongside a react-scripts upgrade.
FROM public.ecr.aws/docker/library/node:18-bookworm

# System packages the dev runtime needs. `procps` only: this app has no
# source-built native modules, so no extra apt library is required.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# yarn 1.x (web/yarn.lock). Pre-activate the exact version so a cold start never
# has to fetch a package manager from the registry before the dev command runs.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install` in this image
# against the bind-mounted checkout). Only the toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
# `HOST` is CRA's bind variable (react-scripts reads HOST/PORT from env).
# `NODE_OPTIONS=--openssl-legacy-provider` keeps the webpack 3 toolchain working
# against OpenSSL 3 (legacy hash algorithms) on this base image.
ENV HOSTNAME=0.0.0.0 \
    HOST=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss \
    CODEPRESS_BASE_PATH=/ \
    BROWSER=none \
    DANGEROUSLY_DISABLE_HOST_CHECK=true \
    NODE_OPTIONS=--openssl-legacy-provider

WORKDIR /app/web
EXPOSE 3000

# Put the app + root bins on PATH so anything the dev command shells out to
# resolves node_modules/.bin. These dirs are populated at run time on the
# bind-mounted checkout. Prepend, never replace, ${PATH}.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on). react-scripts start binds HOST/PORT from env; its
# webpack-dev-server client derives the socket URL from window.location, so the
# HMR websocket rides the public preview origin (wss on 443) with no extra
# wiring. WDS_SOCKET_PORT is mapped anyway for forward compatibility with newer
# react-scripts. Invoked through yarn, never a bare `react-scripts` binary.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" PORT=\"${PORT:-3000}\" WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" BROWSER=none DANGEROUSLY_DISABLE_HOST_CHECK=true yarn start"]
