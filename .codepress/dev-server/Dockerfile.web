# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 10 is deliberate, not a stale default.
#
# web/ pins react-scripts@1.0.10 (Create React App 1.x, React 15). Its dev-server
# socket stack (webpack-dev-server 2.x -> sockjs -> faye-websocket ->
# websocket-driver@0.6.x) calls `process.binding('http_parser')`, which Node
# removed in v12. Every Node >= 12 therefore dies at startup with
#   Error: No such module: http_parser
# before the dev server ever binds a port. Verified while authoring this file:
# Node 25 crashes with exactly that error; Node 10.24.1 compiles the app
# ("Compiled successfully!") and serves the 1.9 MB dev bundle over HTTP 200.
#
# Bump this base image only together with a react-scripts upgrade in
# web/package.json. Node 10 also predates Corepack, so yarn comes from the
# image's own bundled yarn 1.x (see below) instead of `corepack enable`, and
# `--openssl-legacy-provider` is neither needed nor supported here.
#
# Debian buster (not bookworm) is forced by the Node 10 tag — this is the full
# `node:10-buster` image (FROM buildpack-deps:buster), never `-slim`, so the
# node-gyp toolchain (make/gcc/g++/python) is present for the runtime install.
FROM public.ecr.aws/docker/library/node:10-buster

# Debian 10 reached end of life and its suites were moved off deb.debian.org, so
# a plain `apt-get update` on this base now 404s. Point apt at archive.debian.org
# (whose Release files are intentionally expired) before installing.
RUN set -eux; \
    printf '%s\n' \
      'deb http://archive.debian.org/debian buster main contrib non-free' \
      'deb http://archive.debian.org/debian-security buster/updates main contrib non-free' \
      > /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until; \
    apt-get update; \
    apt-get install -y --no-install-recommends procps; \
    rm -rf /var/lib/apt/lists/*

# Package manager: yarn 1.x, already bundled in the official node:10 images.
# web/yarn.lock is a yarn-classic lockfile and web/package.json declares no
# `packageManager` field, so there is nothing to activate and nothing to fetch
# from the registry at cold start.
RUN yarn --version

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install
# --frozen-lockfile` in this image against the bind-mounted checkout). Only the
# toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss

WORKDIR /app/web
EXPOSE 3000

# Put the checkout's bins on PATH so the dev command — and anything it shells out
# to — resolves node_modules/.bin even when a binary is invoked directly. These
# dirs are populated at run time on the bind-mounted checkout. Prepend, never
# replace ${PATH}, so the image's own yarn/node shims survive.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on), invoked through yarn so the `start` script resolves.
#
# CRA 1.x env contract, read straight from the installed react-scripts:
#   * HOST / PORT  -> config/webpackDevServer.config.js binds these directly.
#   * DANGEROUSLY_DISABLE_HOST_CHECK -> webpack-dev-server's host check would
#     otherwise reject the preview's `<session>.preview.codepress.dev` Host
#     header the moment anyone adds a `proxy` field to web/package.json.
#   * BROWSER=none -> don't try to spawn a browser inside the container.
#   * WDS_SOCKET_PORT is inert on react-scripts 1.x (its webpackHotDevClient
#     derives the HMR socket URL from window.location, so HMR already rides the
#     public preview origin). It is mapped from CODEPRESS_HMR_CLIENT_PORT anyway
#     so the wiring keeps working if react-scripts is upgraded to 4.x+.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" BROWSER=none DANGEROUSLY_DISABLE_HOST_CHECK=true WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" yarn start"]
