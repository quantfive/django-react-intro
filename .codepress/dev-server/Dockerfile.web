# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.
#
# Why Node 10 (deliberate, not an oversight): this frontend is create-react-app
# 1.0.10 / webpack-dev-server 2.5.0, whose sockjs dependency chain pins
# websocket-driver 0.6.5, which calls `process.binding('http_parser')`. That
# binding was removed in Node 12, so `react-scripts start` aborts at boot with
#   Error: No such module: http_parser
# on every Node >= 12. Verified while generating this file: Node 10 compiles and
# serves the app, Node 14 and Node 25 both crash. Node 10 images ship only Debian
# buster variants (there is no node:10-bullseye/-bookworm), and buster has moved
# to archive.debian.org — hence the apt sources rewrite below. Bump this base the
# moment the frontend's toolchain is upgraded.
FROM public.ecr.aws/docker/library/node:10-buster

# `system_packages` from recipe.json: procps, so dev-process supervisors can
# inspect and clean up child process trees during SIGTERM shutdown in direct
# MicroVM runtimes. (The full -buster base — not -slim — also supplies the
# node-gyp toolchain: make/gcc/g++/python.)
#
# Debian buster is past EOL and has moved off deb.debian.org, so its repos are
# pinned to archive.debian.org and the Valid-Until check is skipped on the
# expired Release files. archive.debian.org can be slow or briefly unavailable;
# since `ps` already ships in the Debian base, an apt outage falls back to it
# rather than failing the whole dev image. The trailing `command -v ps` is the
# real gate: the build fails if procps is missing either way.
RUN set -eux; \
    printf '%s\n' \
      'deb http://archive.debian.org/debian buster main' \
      'deb http://archive.debian.org/debian-security buster/updates main' \
      > /etc/apt/sources.list; \
    if apt-get -o Acquire::Check-Valid-Until=false update \
       && apt-get install -y --no-install-recommends procps; then \
      echo 'procps installed from archive.debian.org'; \
    else \
      echo 'WARN: archive.debian.org unavailable; relying on the base image procps'; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    command -v ps

# Package manager: the node:10 image ships yarn 1.x, and corepack does not exist
# on Node 10, so there is nothing to enable or activate — this only asserts the
# binary the recipe's `install_command` (`yarn install --frozen-lockfile`) needs.
RUN yarn --version

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install` in this image
# against the bind-mounted checkout at /app). Only the toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
#
# BROWSER=none stops react-scripts from shelling out to a browser opener that
# does not exist in a container.
#
# DANGEROUSLY_DISABLE_HOST_CHECK is the CRA equivalent of Vite's
# `server.allowedHosts = true`, and it is set HERE (in the dev image) rather than
# in the repo, so the app's own config is untouched. CRA 1.x turns on
# webpack-dev-server's DNS-rebinding host check as soon as package.json declares
# a `proxy` field; preview hostnames are unique per session and cannot be
# enumerated ahead of time, so without this a preview would answer every request
# with "Invalid Host header" the day someone adds a dev proxy to package.json.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss \
    BROWSER=none \
    DANGEROUSLY_DISABLE_HOST_CHECK=true

WORKDIR /app/web
EXPOSE 3000

# Put the workspace bins on PATH so the dev command — and anything it shells out
# to — resolves node_modules/.bin even when a binary is invoked directly. These
# dirs are populated at run time on the bind-mounted checkout (hydration /
# runtime install). Prepend, never replace ${PATH}, so the yarn shim survives.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on): `yarn start` -> `react-scripts start`, routed through the
# package manager rather than a bare `react-scripts` bin.
#
# Bind comes from CODEPRESS_BIND_HOST via CRA's own HOST/PORT env vars.
#
# HMR needs no client-port flag here: this app's react-dev-utils (3.0.2) builds
# its sockjs URL from `window.location`, so the HMR websocket rides the page
# origin and connects straight through the preview's wss proxy. WDS_SOCKET_PORT
# is passed anyway for forward compatibility — react-scripts >= 3.4 honors it,
# 1.0.10 ignores it — so this keeps working if the toolchain is upgraded.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" PORT=\"${PORT:-3000}\" WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" yarn start"]
