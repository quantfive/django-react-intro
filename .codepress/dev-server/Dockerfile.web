# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.
#
# WHY NODE 10 (and not a current LTS / -bookworm base):
# This frontend pins react-scripts 1.0.10 (webpack 2.6.1 + webpack-dev-server 2.5.0).
# Its transitive websocket-driver@0.6.5 — pinned by web/yarn.lock, reached via
# sockjs -> faye-websocket — calls process.binding('http_parser'), a Node internal
# that was REMOVED in Node 12. On any modern Node the dev server dies at startup with
# "Error: No such module: http_parser" before it ever binds a port, so there is no
# bookworm or current-LTS base that can run this frontend as locked.
# Verified against node 10.24.1: `yarn install --frozen-lockfile` installs cleanly with
# zero native compilation, the app compiles, and / plus /static/js/bundle.js serve 200.
# Node 10 also still ships OpenSSL 1.1.1, so webpack 2's md4 hashing works and this
# image must NOT set --openssl-legacy-provider (that flag does not exist on Node 10).
# If web/package.json is ever upgraded to a modern react-scripts, switch this base to
# the standard public.ecr.aws/docker/library/node:<lts>-bookworm image.
#
# The base image bundles yarn 1.22.5, so no corepack (absent on Node 10) and no
# package-manager install step are needed here.
FROM public.ecr.aws/docker/library/node:10.24.1-buster

# System packages: procps only. This app's dependency tree compiles no native modules
# (fsevents is darwin-only and optional), so no extra apt library is required.
# Debian buster is EOL — deb.debian.org and security.debian.org both return 404 for it
# now, and the archived Release files are expired. Repoint apt at archive.debian.org and
# skip the expiry check, otherwise `apt-get update` fails and this image never builds.
RUN printf 'deb http://archive.debian.org/debian buster main\ndeb http://archive.debian.org/debian-security buster/updates main\n' > /etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until \
    && apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install --frozen-lockfile` in
# this image against the bind-mounted checkout). Only the toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
# create-react-app 1.x reads HOST and PORT from the environment (its own default bind is
# already 0.0.0.0). Its HMR client (react-dev-utils 3.0.2 webpackHotDevClient) builds the
# SockJS URL from window.location — protocol, hostname and port of the page — so behind
# the preview proxy the websocket resolves to wss://<preview-host>/sockjs-node on its own.
# CRA 1.x has no WDS_SOCKET_PORT/WDS_SOCKET_HOST support (those arrived in CRA 4), so
# CODEPRESS_HMR_CLIENT_PORT / CODEPRESS_HMR_PROTOCOL are declared for the uniform runtime
# contract and are honoured by the proxy layer rather than by this dev server.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss \
    BROWSER=none \
    DANGEROUSLY_DISABLE_HOST_CHECK=true

# BROWSER=none: CRA 1.x calls openBrowser() on start; without this it tries to launch a
# browser inside the container.
# DANGEROUSLY_DISABLE_HOST_CHECK: webpack-dev-server 2.x rejects requests whose Host
# header is not local ("Invalid Host header"), which every proxied preview origin is.
# CRA already disables that check while web/package.json declares no `proxy` field; this
# keeps the preview working if a `proxy` entry is later added to talk to the Django API.
# Dev-image only — it is never part of a production build.

WORKDIR /app/web
EXPOSE 3000

# Put the app's bins on PATH so anything the dev command shells out to resolves
# node_modules/.bin. Populated at run time on the bind-mounted checkout.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on). Routed through yarn, never a bare react-scripts binary.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" yarn start"]
