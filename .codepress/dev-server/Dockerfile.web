# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 18 is the oldest bookworm-based LTS, which is the closest match for this
# app's toolchain (react-scripts 1.0.10 / webpack 3 / React 15). The FULL image
# (never -slim) is required: dependencies install at run time and need the
# node-gyp toolchain (make/gcc/g++/python3) that -slim strips out.
FROM public.ecr.aws/docker/library/node:18-bookworm

# System packages the dev runtime needs. `procps` only: this app has no
# source-built native modules, so no extra apt library is required.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# Bake the Yarn Classic binary (the repo's lockfile is yarn lockfile v1, and no
# `packageManager` field is declared) so a cold start never has to fetch a
# package manager from the public registry. No app dependencies are installed
# here.
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install
# --frozen-lockfile` in this image against the bind-mounted checkout). Only the
# toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss

# webpack 3 hashes with MD4, which OpenSSL 3 (Node 17+) refuses by default; the
# legacy provider re-enables it. Without this, `react-scripts start` dies with
# `error:0308010C:digital envelope routines::unsupported`. Also declared inline
# in the CMD so the dev command is self-sufficient under any runtime.
ENV NODE_OPTIONS=--openssl-legacy-provider

# react-scripts tries to open a desktop browser on start; there is none here.
ENV BROWSER=none

WORKDIR /app/web
EXPOSE 3000

# Put the workspace bins on PATH so the dev command — and anything it shells out
# to — resolves node_modules/.bin even when a binary is invoked directly. These
# dirs are populated at run time on the bind-mounted checkout. Prepend, never
# replace ${PATH}, so the corepack/yarn shims survive.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on) — run through the package manager, never a bare binary.
# react-scripts 1.x reads HOST and PORT from the environment, and its HMR client
# derives the websocket URL from window.location, so the socket follows the
# preview origin automatically (this version has no client-port flag).
# WDS_SOCKET_PORT is exported for the uniform runtime contract and for a future
# react-scripts upgrade that honors it.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" BROWSER=none NODE_OPTIONS=--openssl-legacy-provider WDS_SOCKET_PORT=\"$CODEPRESS_HMR_CLIENT_PORT\" yarn start"]
