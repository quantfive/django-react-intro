# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 18 is the oldest Debian bookworm Node image and the closest match for this
# app's toolchain (react-scripts 1.0.10 / webpack 3, React 15). The FULL image
# (not -slim) is required: dependencies install at run time and node-gyp needs the
# make/gcc/g++/python3 toolchain that -slim strips out.
FROM public.ecr.aws/docker/library/node:18-bookworm

# System packages the dev runtime needs. `procps` only — nothing in this app's
# lockfile is a source-built native module that links against an extra apt
# library, and `ps` is what dev-process supervisors use to clean up on shutdown.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# THIN image: no node_modules, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install
# --frozen-lockfile` inside this image against the bind-mounted checkout).
#
# Enable Corepack so the runtime consistently resolves Yarn through the supported
# package-manager shim. The app has no pinned `packageManager` field, so this
# intentionally activates the bundled default rather than fetching a version.
RUN corepack enable

# HMR + bind config — values come from the runtime, never hardcoded.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss

# webpack 3 (react-scripts 1.x) hashes with md4, which OpenSSL 3 disables — without
# this the dev server dies with `error:0308010C:digital envelope routines::unsupported`.
# BROWSER=none stops CRA from trying to launch a browser in a headless container.
ENV NODE_OPTIONS=--openssl-legacy-provider \
    BROWSER=none

WORKDIR /app/web
EXPOSE 3000

# Put the app + root bins on PATH as a backstop so anything the dev command shells
# out to resolves node_modules/.bin. These dirs are populated at run time on the
# bind-mounted checkout. Prepend — never replace ${PATH}.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on), invoked through the package manager. CRA reads HOST and
# PORT from env; WDS_SOCKET_PORT points the webpack-dev-server HMR client at the
# public proxy port instead of the in-container port, and the host check is
# disabled so the preview's proxied hostname is accepted.
CMD ["sh", "-c", "NODE_OPTIONS=\"--openssl-legacy-provider\" HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" DANGEROUSLY_DISABLE_HOST_CHECK=true yarn start"]
