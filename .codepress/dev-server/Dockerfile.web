# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 18 rather than the current LTS is deliberate. This app pins
# react-scripts 1.0.10, whose toolchain is webpack 2.6.1 + babel 6 + jest 20.
# That stack was verified to install and compile cleanly on Node 18; newer Node
# majors drop APIs it depends on. node:18-bookworm is the oldest bookworm-based
# official Node tag, so it still ships apt plus the node-gyp toolchain
# (make/gcc/g++/python3) that a runtime dependency install may need.
FROM public.ecr.aws/docker/library/node:18-bookworm

# System packages beyond the node-gyp toolchain the full -bookworm base provides.
# `procps` only: a verified `yarn install --frozen-lockfile` against this lockfile
# builds no native module from source (fsevents is darwin-only and skipped on
# linux), so no additional apt library is required. procps supplies `ps`, which
# dev-process supervisors shell out to during SIGTERM cleanup.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# This repo declares no `packageManager`, so pin the final Yarn 1.x explicitly and
# bake it into the image. Leaving corepack to resolve a bare `yarn` would make a
# cold start fetch the package manager from the public registry before the dev
# server could boot. Yarn 1 is required: web/yarn.lock is a v1 lockfile.
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install --frozen-lockfile`
# in this image against the bind-mounted checkout). Only the toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss

# react-scripts would otherwise try to launch a browser on start.
ENV BROWSER=none

# react-scripts disables webpack-dev-server's DNS-rebinding host check unless the
# app declares a `proxy` in package.json. web/package.json declares none today, so
# the check is already off. Setting this keeps arbitrary preview hostnames working
# if a `proxy` is added later — without it, that change would make previews fail
# with "Invalid Host header".
ENV DANGEROUSLY_DISABLE_HOST_CHECK=true

WORKDIR /app/web
EXPOSE 3000

# Put the app's bins on PATH as a backstop so anything shelling out to a
# node_modules/.bin binary resolves it. These dirs are populated at run time on the
# bind-mounted checkout. Prepend — never replace ${PATH} — so the corepack/yarn
# shims above survive.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on), routed through the package manager rather than a bare bin.
# `react-scripts start` reads HOST and PORT from the environment, so the bind
# address always comes from CODEPRESS_BIND_HOST, never from a hardcoded literal.
#
# This react-scripts version's HMR client builds its SockJS URL from the page
# origin (window.location protocol/hostname/port), so it dials back through the
# preview proxy on 443/wss with no extra wiring. WDS_SOCKET_PORT/PROTOCOL are still
# exported from the CodePress HMR vars so the wiring keeps working if react-scripts
# is later upgraded to a version that reads them.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" WDS_SOCKET_PROTOCOL=\"${CODEPRESS_HMR_PROTOCOL:-wss}\" yarn start"]
