# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 16 is deliberate, NOT the current LTS. This app pins react-scripts 1.0.10,
# which builds with webpack 2.6.1 (confirmed in web/yarn.lock). Webpack < 5 hashes
# with MD4 through OpenSSL, and Node 17+ ships OpenSSL 3 where MD4 is gone — the
# dev server would die at startup with
# `error:0308010C:digital envelope routines::unsupported`. Node 16 (OpenSSL 1.1.1)
# runs this toolchain unmodified, with no --openssl-legacy-provider hack.
#
# Full -bookworm, never -slim: dependencies install at RUN TIME inside this image,
# so the node-gyp toolchain (make/gcc/g++/python3) must be present.
FROM public.ecr.aws/docker/library/node:16-bookworm

# System packages (recipe `system_packages`). `procps` only — this dependency tree
# has no source-built native module (webpack 2 / babel / react 15 are pure JS, and
# the only platform-native package, fsevents, is darwin-only and optional), so no
# extra apt library is needed. `ps` is required so dev-process supervisors can
# inspect and clean up child process trees on SIGTERM in direct MicroVM runtimes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# Package manager: Yarn Classic (web/yarn.lock is `yarn lockfile v1`). The node:16
# base already ships yarn 1.x, and the repo declares no `packageManager` field, so
# corepack is intentionally NOT enabled: its shims would have no pinned version to
# resolve and could try to fetch a package manager from the public registry during a
# MicroVM cold start. Assert the binary exists now so a missing yarn fails the image
# build loudly instead of failing the dev server at run time.
RUN yarn --version

WORKDIR /app

# THIN image: no node_modules and no source COPY. The dev-server runtime bind-mounts
# the checkout at /app and provides dependencies there (squashfs hydration, or
# `yarn install --frozen-lockfile` run in this image against the checkout).

# HMR + bind config — values are supplied by the runtime, never hardcoded.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss

WORKDIR /app/web
EXPOSE 3000

# Bin backstop so a binary invoked directly still resolves. These dirs are populated
# at run time on the bind-mounted checkout. Prepend — never replace ${PATH}.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on): `react-scripts start` via yarn. Never a production build.
#
#   HOST / PORT   react-scripts reads both directly — its
#                 config/webpackDevServer.config.js does
#                 `host: process.env.HOST || '0.0.0.0'` — so this is the bind wiring.
#
#   BROWSER=none  headless container; don't try to launch a browser on start.
#
#   DANGEROUSLY_DISABLE_HOST_CHECK
#                 a preview is served at an arbitrary `*.preview.codepress.dev`
#                 Host, and webpack-dev-server 2.5.0 rejects unknown Host headers
#                 with "Invalid Host header". react-scripts computes
#                 `disableHostCheck: !proxy || DANGEROUSLY_DISABLE_HOST_CHECK`, so
#                 it is already disabled while web/package.json declares no `proxy`.
#                 Setting it explicitly keeps previews working if a `proxy` to the
#                 Django API is added later. Dev-server only — it never affects a
#                 production build.
#
#   WDS_SOCKET_PORT
#                 forward-compatibility only. react-scripts 1.0.10's HMR client
#                 (react-dev-utils/webpackHotDevClient) builds its SockJS URL from
#                 window.location protocol/hostname/port, so it already follows the
#                 wss:// preview origin with no configuration and ignores this var.
#                 It becomes meaningful if react-scripts is upgraded to 3.4+.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" PORT=\"${PORT:-3000}\" BROWSER=none DANGEROUSLY_DISABLE_HOST_CHECK=true WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" yarn start"]
