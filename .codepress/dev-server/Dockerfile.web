# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 16 is deliberate here, not an oversight: web/ is Create React App 1.0.10,
# whose pinned toolchain is webpack 2.6.1 + webpack-dev-server 2.5.0. webpack 2
# hashes modules with MD4 via crypto.createHash('md4'). Node 17+ ships OpenSSL 3,
# which removed MD4 from the default provider, so on a newer base the dev server
# dies on boot with "error:0308010C:digital envelope routines::unsupported".
# Node 16 (OpenSSL 1.1.1) runs this 2017-era toolchain natively, so no
# --openssl-legacy-provider workaround is needed. Bump this only alongside a
# react-scripts upgrade.
FROM public.ecr.aws/docker/library/node:16-bookworm

# System packages. `procps` only: this app's dependency tree contains no
# source-built native module (no node-sass / canvas / node-pty / bcrypt), so no
# apt library is required. `procps` gives dev-process supervisors `ps` so they can
# clean up child process trees during SIGTERM shutdown in direct MicroVM runtimes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# Yarn 1.x ships in the official node image and matches this repo's
# "yarn lockfile v1". The repo declares no `packageManager`, so corepack is left
# disabled on purpose — enabling it would make the yarn shim resolve (and download)
# a package manager from the registry on a cold start. Assert yarn is present at
# build time so a missing package manager fails the image build, not the preview.
RUN yarn --version

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time — either a pre-built node_modules squashfs overlay, or
# `yarn install --frozen-lockfile` inside this image against the bind-mounted
# checkout at /app.

# HMR + bind config. Values come from the runtime; no loopback host is hardcoded
# anywhere below. Notes on how CRA consumes these:
#   * HOST / PORT   — react-scripts' dev-server config reads `process.env.HOST ||
#                     '0.0.0.0'` and start.js reads `process.env.PORT`, so binding
#                     is fully env-driven.
#   * HMR websocket — react-dev-utils 3.0.2's webpackHotDevClient builds the SockJS
#                     URL from `window.location` (protocol + hostname + port), so
#                     the socket automatically follows the browser's own origin.
#                     Behind the preview proxy that resolves to wss://<host>:443,
#                     which is why no client-port flag exists (and CRA 1.x has no
#                     WDS_SOCKET_PORT support). The CODEPRESS_HMR_* vars stay
#                     declared for the uniform runtime contract.
#   * BROWSER=none  — stops react-scripts trying to launch a browser in the container.
#   * DANGEROUSLY_DISABLE_HOST_CHECK — CRA computes
#                     `disableHostCheck: !proxy || DANGEROUSLY_DISABLE_HOST_CHECK === 'true'`.
#                     web/package.json declares no `proxy` today, so the host check
#                     is already off; setting this keeps previews working if a
#                     `proxy` entry is later added to reach the Django API (which
#                     would otherwise reject the preview Host with "Invalid Host
#                     header"). Dev-image only — this is never used for a build.
ENV HOSTNAME=0.0.0.0 \
    HOST=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss \
    BROWSER=none \
    DANGEROUSLY_DISABLE_HOST_CHECK=true

WORKDIR /app/web
EXPOSE 3000

# Put the checkout's bins on PATH as a backstop so `react-scripts` resolves even if
# a binary is ever invoked directly. These dirs are populated at run time on the
# bind-mounted checkout. Prepend, never replace, ${PATH}.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on) — react-scripts start via yarn, never a bare bin, and never
# a production build. HOST is mapped from CODEPRESS_BIND_HOST so a runtime override
# of the bind address reaches CRA, which only understands HOST.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" PORT=\"${PORT:-3000}\" BROWSER=none yarn start"]
