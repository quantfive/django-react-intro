# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 18 is the newest LTS that still runs this app's legacy toolchain
# (react-scripts 1.0.10 / webpack 2). The FULL -bookworm base (never -slim) ships
# the node-gyp toolchain the runtime dependency install needs.
FROM public.ecr.aws/docker/library/node:18-bookworm

# System packages the dev runtime needs. `procps` only: nothing in this app's
# lockfile builds a native module from source (fsevents@1 is darwin-only and is
# skipped on linux), so no extra apt library is required.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# The repo ships a yarn v1 lockfile and declares no `packageManager`, so enable
# corepack and let it resolve yarn classic. This bakes only the package-manager
# shim, never application dependencies.
RUN corepack enable

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install
# --frozen-lockfile` in this image against the bind-mounted checkout). Only the
# toolchain lives here.

# HMR + bind config — values come from the runtime, never hardcoded.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss

# Legacy-toolchain shims for react-scripts 1.x:
#  - loader-utils@1 hashes emitted assets with md4, which OpenSSL 3 (Node 17+)
#    removed from the default provider; without this the dev server crashes with
#    `error:0308010C:digital envelope routines::unsupported`.
#  - BROWSER=none: there is no browser to open inside the container.
#  - DANGEROUSLY_DISABLE_HOST_CHECK: previews are served from a per-session
#    hostname, so webpack-dev-server must accept an arbitrary Host header. This
#    is a dev-preview image only; it never affects a production build.
ENV NODE_OPTIONS=--openssl-legacy-provider \
    BROWSER=none \
    DANGEROUSLY_DISABLE_HOST_CHECK=true

WORKDIR /app/web
EXPOSE 3000

# Put the checkout's bins on PATH as a backstop so `react-scripts` resolves even
# when something invokes it directly. These dirs are populated at run time on the
# bind-mounted checkout. Prepend, never replace ${PATH}, so the corepack/yarn
# shims survive.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on). react-scripts start reads HOST/PORT from env; its HMR
# client (sockjs at /sockjs-node) connects back to the page origin, so the public
# edge only needs the websocket upgrade proxied. WDS_SOCKET_PORT is mapped from
# the runtime's public-port var for newer react-scripts compatibility. The
# assignments are repeated here (not only as ENV) so the same command is
# self-contained when the MicroVM runtime runs it directly.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" PORT=\"${PORT:-3000}\" BROWSER=none WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" DANGEROUSLY_DISABLE_HOST_CHECK=true NODE_OPTIONS=--openssl-legacy-provider yarn start"]
