# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "web" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.

# Node 16 on the full (non-slim) Debian bookworm base.
#
# Node version: this app runs Create React App 1.0.10 (webpack 2.6.1 /
# webpack-dev-server 2.5.0). That webpack hashes modules with MD4, which OpenSSL 3
# removes -- on Node 17+ the dev server dies immediately with
# `error:0308010C:digital envelope routines::unsupported`. Node 16 still ships
# OpenSSL 1.1.1, so the dev server starts as-is with no legacy-provider flag.
# Base variant: full `-bookworm`, never `-slim`, so the node-gyp toolchain
# (make/gcc/g++/python3) is present for the runtime dependency install.
FROM public.ecr.aws/docker/library/node:16-bookworm

# System packages the dev runtime needs. `procps` only: nothing in this app's
# lockfile builds a native module from source, so no extra apt library is
# required. `procps` gives dev-process supervisors `ps` for clean shutdown.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# THIN image: no `node_modules`, no source COPY. The dev-server runtime provides
# dependencies at run time (squashfs hydration, or `yarn install
# --frozen-lockfile` in this image against the bind-mounted checkout). Only the
# toolchain lives here.
#
# Package manager: the repo declares no `packageManager` field and uses a Yarn 1
# (`yarn.lock`) classic lockfile, so we rely on the Yarn 1.22.x that ships in the
# official Node image rather than enabling corepack -- a corepack shim with no
# declared version would try to fetch a package manager from the public registry
# on a cold start before the dev command could run.

# HMR + bind config -- values come from the runtime, never hardcoded.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=3000 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss

# Never try to launch a browser inside the container.
ENV BROWSER=none

# webpack-dev-server 2.4.3+ rejects requests whose Host header it does not
# recognize (a DNS-rebinding guard for local dev). Every preview is served from a
# unique `*.preview.codepress.dev` host through the CodePress proxy, so the guard
# would answer "Invalid Host header" instead of the app. This app declares no
# `proxy` in package.json, so CRA already disables the check; the flag is set
# explicitly so the preview keeps working if a `proxy` is added later. Dev image
# only -- it never reaches a build or a deployed environment.
ENV DANGEROUSLY_DISABLE_HOST_CHECK=true

WORKDIR /app/web
EXPOSE 3000

# Put the workspace bins on PATH so the dev command -- and anything it shells out
# to -- resolves node_modules/.bin even when a binary is invoked directly. These
# dirs are populated at run time on the bind-mounted checkout (hydration /
# runtime install). Prepend, never replace `${PATH}`.
ENV PATH="/app/web/node_modules/.bin:/app/node_modules/.bin:${PATH}"

# Dev command (HMR on), routed through the package manager.
#
# `react-scripts start` reads its bind address from HOST and its port from PORT,
# so both are derived from the runtime contract here rather than hardcoded.
# HMR: react-dev-utils 3.x builds the dev-server websocket URL from
# `window.location` (protocol + hostname + port) in the browser, so it dials
# `wss://<preview-host>/sockjs-node` on its own -- exactly what the preview proxy
# serves, with no client-port flag needed. WDS_SOCKET_PORT is exported anyway for
# the uniform runtime contract and for a future CRA upgrade (CRA 3.4+ reads it).
#
# If file edits ever stop triggering a rebuild in a preview, set
# CHOKIDAR_USEPOLLING=true in the Live Dev Server env settings; it is left off by
# default because inotify works over the bind-mounted checkout and polling burns CPU.
CMD ["sh", "-c", "HOST=\"${CODEPRESS_BIND_HOST:-0.0.0.0}\" PORT=\"${PORT:-3000}\" WDS_SOCKET_PORT=\"${CODEPRESS_HMR_CLIENT_PORT:-443}\" BROWSER=none yarn start"]
